---
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import newsreaderUrl from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import newsreaderItalicUrl from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-italic.woff2?url';
import instrumentSansUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import { getSiteSettings } from '../lib/content/loader';
import { NOINDEX } from '../lib/content/site';
import { withBase } from '../lib/base';
import MembersShell from '../components/members/MembersShell.astro';
import pkg from '../../package.json';

interface Props {
  title: string;
  description?: string;
  /** 'teacher' | 'family' | undefined: highlights the section in the header. */
  section?: 'teacher' | 'family';
  noindex?: boolean;
}

const { title, description, section, noindex } = Astro.props;
const settings = getSiteSettings();
const blockIndexing = NOINDEX || noindex === true;
const version = pkg.version;
// Under the members proxy (base path set) render the website's shared header and
// members sub-nav; standalone keeps the app's own compact header.
const membersShell = (import.meta.env.BASE_URL || '/') !== '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      // Appearance: apply the saved theme before first paint to avoid a flash.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch {
        /* storage unavailable */
      }
    </script>
    <title>{title} · {settings.site_name}</title>
    {description && <meta name="description" content={description} />}
    {blockIndexing && <meta name="robots" content="noindex,nofollow" />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#F7F6F3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17171A" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('/icons/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={newsreaderUrl} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={newsreaderItalicUrl} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={instrumentSansUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {membersShell && <MembersShell />}
    {!membersShell && (
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__brand site-header__name" href={withBase('/')}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 240 210"
            width="30"
            height="26"
            fill="none"
            stroke="currentColor"
            stroke-width="12"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M120 22v138"></path>
            <path d="M72 70h96"></path>
            <path d="M18 196c36-26 66-38 102-38s66 12 102 38"></path>
          </svg>
          <span>{settings.site_name}</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <a href={withBase('/teacher/')} aria-current={section === 'teacher' ? 'true' : undefined}>Teachers</a>
          <a href={withBase('/family/')} aria-current={section === 'family' ? 'true' : undefined}>Parents</a>
        </nav>
      </div>
    </header>
    )}
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>Wellington Church of Christ | Sunday School Lessons</p>
        <form class="theme" data-theme-switch>
          <fieldset class="theme-set">
            <legend class="visually-hidden">Appearance</legend>
            <span class="theme-label" aria-hidden="true">Appearance</span>
            <label class="theme-opt">
              <input type="radio" name="theme" value="system" checked /><span>Auto</span>
            </label>
            <label class="theme-opt">
              <input type="radio" name="theme" value="light" /><span>Light</span>
            </label>
            <label class="theme-opt">
              <input type="radio" name="theme" value="dark" /><span>Dark</span>
            </label>
          </fieldset>
        </form>
        <p class="site-footer__meta">v{version}</p>
      </div>
    </footer>
    <script>
      // Appearance: Auto follows the device; Light and Dark are remembered on this device.
      const KEY = 'theme';
      const root = document.documentElement;
      const read = (): string => {
        try {
          return localStorage.getItem(KEY) ?? 'system';
        } catch {
          return 'system';
        }
      };
      const apply = (value: string) => {
        if (value === 'light' || value === 'dark') root.dataset.theme = value;
        else delete root.dataset.theme;
        try {
          if (value === 'system') localStorage.removeItem(KEY);
          else localStorage.setItem(KEY, value);
        } catch {
          /* private mode: the choice lasts for this page only */
        }
      };
      for (const form of document.querySelectorAll<HTMLFormElement>('[data-theme-switch]')) {
        const current = read();
        const radio = form.querySelector<HTMLInputElement>(`input[value="${current}"]`);
        if (radio) radio.checked = true;
        form.addEventListener('change', (event) => {
          const input = event.target as HTMLInputElement;
          if (input.name === 'theme') apply(input.value);
        });
        form.addEventListener('submit', (event) => event.preventDefault());
      }
    </script>
  </body>
</html>

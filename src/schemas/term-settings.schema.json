{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/term-settings-v1.json",
  "title": "School Term Settings",
  "description": "Wellington school term start and end dates per year. The site auto-generates the teaching schedule by assigning each segment's lesson sequence to term-time Sundays and marking holiday Sundays as breaks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["timezone", "terms"],
  "properties": {
    "timezone": {
      "const": "Pacific/Auckland"
    },
    "break_message": {
      "type": "string",
      "minLength": 5
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term_id", "year", "term", "start", "end"],
        "properties": {
          "term_id": {
            "type": "string",
            "pattern": "^20[0-9]{2}-T[1-4]$"
          },
          "year": {
            "type": "integer",
            "minimum": 2024,
            "maximum": 2100
          },
          "term": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}

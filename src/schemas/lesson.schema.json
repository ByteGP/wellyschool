{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/lesson-content-v1.2.json",
  "title": "Sunday School Canonical Lesson Content",
  "description": "CMS-neutral source object for Teacher and Family experiences rendered from one governed lesson. Version 1.2 normalizes quiz answers and puzzle solutions into typed objects so Git-based CMS editors do not need polymorphic fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lesson_id",
    "content_version",
    "status",
    "curriculum",
    "core",
    "learning",
    "teacher",
    "family",
    "engagement",
    "accessibility",
    "safeguarding",
    "editorial"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "lesson_id": {
      "type": "string",
      "pattern": "^[KYT][1-5]-L[0-9]{2}$"
    },
    "content_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "vertical_slice_draft",
        "in_review",
        "approved",
        "scheduled",
        "published",
        "retired"
      ]
    },
    "curriculum": {
      "$ref": "#/$defs/curriculum"
    },
    "core": {
      "$ref": "#/$defs/core"
    },
    "learning": {
      "$ref": "#/$defs/learning"
    },
    "teacher": {
      "$ref": "#/$defs/teacher"
    },
    "family": {
      "$ref": "#/$defs/family"
    },
    "engagement": {
      "$ref": "#/$defs/engagement"
    },
    "accessibility": {
      "$ref": "#/$defs/accessibility"
    },
    "safeguarding": {
      "$ref": "#/$defs/safeguarding"
    },
    "editorial": {
      "$ref": "#/$defs/editorial"
    }
  },
  "$defs": {
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "role"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 3
        },
        "role": {
          "enum": [
            "primary",
            "supporting",
            "context",
            "comparison"
          ]
        },
        "reading_note": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "classification",
        "evidence_refs",
        "confidence",
        "review_status"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^C[0-9]{2}$"
        },
        "statement": {
          "type": "string",
          "minLength": 10
        },
        "classification": {
          "enum": [
            "explicit_text",
            "canonical_synthesis",
            "strong_inference",
            "framework_position",
            "disputed",
            "historical_context",
            "prudential_judgment"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "confidence": {
          "enum": [
            "High",
            "Medium",
            "Low"
          ]
        },
        "review_status": {
          "enum": [
            "draft",
            "review_required",
            "approved"
          ]
        },
        "credible_alternative": {
          "type": "string"
        },
        "interpretive_hinge": {
          "type": "string"
        },
        "prohibited_overstatement": {
          "type": "string"
        }
      }
    },
    "curriculum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment",
        "age_range",
        "cycle_id",
        "cycle_name",
        "sequence",
        "unit_type",
        "title"
      ],
      "properties": {
        "segment": {
          "enum": [
            "Kids",
            "Youths",
            "Teens"
          ]
        },
        "age_range": {
          "enum": [
            "4-8",
            "9-12",
            "13-17"
          ]
        },
        "cycle_id": {
          "type": "string",
          "pattern": "^[KYT][1-5]$"
        },
        "cycle_name": {
          "type": "string"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "unit_type": {
          "enum": [
            "Core",
            "Synthesis",
            "Flex"
          ]
        },
        "scheduling_priority": {
          "enum": [
            "Required",
            "Recommended",
            "Optional"
          ]
        },
        "title": {
          "type": "string"
        },
        "annual_anchor": {
          "type": "string"
        },
        "thematic_unit": {
          "type": "string"
        }
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "big_idea",
        "passages",
        "metanarrative_position",
        "biblical_genre",
        "claims",
        "doctrine_tags",
        "formation_tags"
      ],
      "properties": {
        "big_idea": {
          "type": "string"
        },
        "passages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/passage"
          },
          "minItems": 1
        },
        "metanarrative_position": {
          "type": "string"
        },
        "biblical_genre": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "minItems": 2
        },
        "doctrine_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "formation_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interpretation_skill": {
          "type": "string"
        },
        "key_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "foundation_objective",
        "extension_objective",
        "know",
        "understand",
        "practise",
        "become"
      ],
      "properties": {
        "foundation_objective": {
          "type": "string"
        },
        "extension_objective": {
          "type": "string"
        },
        "know": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "understand": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "practise": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "become": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "success_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "purpose"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^Q[0-9]{2}$"
        },
        "question": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "foundation_prompt": {
          "type": "string"
        },
        "extension_prompt": {
          "type": "string"
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id",
        "title",
        "duration_minutes",
        "materials",
        "steps",
        "learning_link"
      ],
      "properties": {
        "activity_id": {
          "type": "string",
          "pattern": "^A[0-9]{2}$"
        },
        "title": {
          "type": "string"
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "learning_link": {
          "type": "string"
        },
        "low_resource_alternative": {
          "type": "string"
        }
      }
    },
    "outline_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "minutes",
        "label",
        "instructions"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^[ESX][0-9]{2}$"
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "label": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "question_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^Q[0-9]{2}$"
          }
        },
        "activity_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^A[0-9]{2}$"
          }
        },
        "resource_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "teacher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_profile",
        "preparation_minutes",
        "zero_prep_card",
        "preparation",
        "delivery_profiles",
        "discussion_questions",
        "activities",
        "closing"
      ],
      "properties": {
        "default_profile": {
          "enum": [
            "essential",
            "standard",
            "extended"
          ]
        },
        "preparation_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 90
        },
        "zero_prep_card": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "objective",
            "read",
            "opening",
            "say",
            "ask",
            "do",
            "close",
            "materials"
          ],
          "properties": {
            "objective": {
              "type": "string"
            },
            "read": {
              "type": "string"
            },
            "opening": {
              "type": "string"
            },
            "say": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            },
            "ask": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            },
            "do": {
              "type": "string"
            },
            "close": {
              "type": "string"
            },
            "materials": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "preparation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passage_context",
            "text_observations",
            "interpretation_notes",
            "theological_guardrails",
            "likely_questions"
          ],
          "properties": {
            "passage_context": {
              "type": "string"
            },
            "text_observations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2
            },
            "interpretation_notes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "theological_guardrails": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "likely_questions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/question"
              }
            }
          }
        },
        "discussion_questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          },
          "minItems": 3
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity"
          },
          "minItems": 1
        },
        "closing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "memory_reference",
            "prayer_prompt",
            "take_home_line"
          ],
          "properties": {
            "memory_reference": {
              "type": "string"
            },
            "prayer_prompt": {
              "type": "string"
            },
            "take_home_line": {
              "type": "string"
            }
          }
        },
        "printable_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delivery_profiles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "essential",
            "standard",
            "extended"
          ],
          "properties": {
            "essential": {
              "$ref": "#/$defs/delivery_profile"
            },
            "standard": {
              "$ref": "#/$defs/delivery_profile"
            },
            "extended": {
              "$ref": "#/$defs/delivery_profile"
            }
          }
        }
      }
    },
    "family_flow_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_minutes",
        "type",
        "instructions"
      ],
      "properties": {
        "duration_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "type": {
          "enum": [
            "connect",
            "read",
            "understand",
            "play",
            "respond"
          ]
        },
        "instructions": {
          "type": "string"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_minutes",
        "title",
        "parent_intro",
        "flow",
        "questions",
        "interactive",
        "weekly_action",
        "prayer",
        "parent_note"
      ],
      "properties": {
        "duration_minutes": {
          "const": 15
        },
        "title": {
          "type": "string"
        },
        "parent_intro": {
          "type": "string"
        },
        "flow": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/family_flow_step"
          },
          "minItems": 5,
          "maxItems": 5
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "interactive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "title",
            "instructions"
          ],
          "properties": {
            "type": {
              "enum": [
                "quiz",
                "puzzle",
                "discussion",
                "movement",
                "creative",
                "audit"
              ]
            },
            "title": {
              "type": "string"
            },
            "instructions": {
              "type": "string"
            }
          }
        },
        "weekly_action": {
          "type": "string"
        },
        "prayer": {
          "type": "string"
        },
        "parent_note": {
          "type": "string"
        }
      }
    },
    "quiz_question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "question",
        "type",
        "answer",
        "explanation"
      ],
      "properties": {
        "question_id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "type": {
          "enum": [
            "multiple_choice",
            "true_false",
            "sequence",
            "scenario",
            "short_answer"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer": {
          "$ref": "#/$defs/quiz_answer"
        },
        "explanation": {
          "type": "string"
        }
      }
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quiz",
        "puzzle",
        "printables"
      ],
      "properties": {
        "quiz": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quiz_question"
          },
          "minItems": 3
        },
        "puzzle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "title",
            "instructions",
            "solution"
          ],
          "properties": {
            "type": {
              "enum": [
                "sequence",
                "matching",
                "sort",
                "word_scramble",
                "case_grid"
              ]
            },
            "title": {
              "type": "string"
            },
            "instructions": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "solution": {
              "$ref": "#/$defs/puzzle_solution"
            },
            "choices": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "printables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource_id",
              "title",
              "purpose",
              "format",
              "status"
            ],
            "properties": {
              "resource_id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "format": {
                "enum": [
                  "A4",
                  "US Letter",
                  "cards",
                  "worksheet",
                  "none"
                ]
              },
              "status": {
                "enum": [
                  "placeholder",
                  "content_source_draft",
                  "ready"
                ]
              }
            }
          }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reading_level",
        "plain_language_rule",
        "neurodiversity_supports",
        "sensory_notes",
        "non_reader_support"
      ],
      "properties": {
        "reading_level": {
          "type": "string"
        },
        "plain_language_rule": {
          "type": "string"
        },
        "neurodiversity_supports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensory_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "non_reader_support": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "safeguarding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensitivity_tags",
        "do_not_ask",
        "teacher_response",
        "escalation_required"
      ],
      "properties": {
        "sensitivity_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "do_not_ask": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "teacher_response": {
          "type": "string"
        },
        "escalation_required": {
          "type": "boolean"
        },
        "escalation_note": {
          "type": "string"
        }
      }
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_provenance",
        "decision_register_refs",
        "review_flags",
        "review_state",
        "scripture_text_policy"
      ],
      "properties": {
        "source_provenance": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "decision_register_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exegetical",
            "developmental",
            "pastoral",
            "copy"
          ],
          "properties": {
            "exegetical": {
              "enum": [
                "not_started",
                "in_review",
                "approved",
                "not_required"
              ]
            },
            "developmental": {
              "enum": [
                "not_started",
                "in_review",
                "approved",
                "not_required"
              ]
            },
            "pastoral": {
              "enum": [
                "not_started",
                "in_review",
                "approved",
                "not_required",
                "deferred_owner_managed"
              ]
            },
            "copy": {
              "enum": [
                "not_started",
                "in_review",
                "approved"
              ]
            }
          }
        },
        "scripture_text_policy": {
          "type": "string"
        },
        "editor_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "delivery_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "duration_minutes",
        "use_case",
        "outline"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "duration_minutes": {
          "enum": [
            25,
            40,
            55
          ]
        },
        "use_case": {
          "type": "string"
        },
        "outline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outline_step"
          },
          "minItems": 4
        }
      }
    },
    "quiz_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "text",
            "boolean",
            "ordered_list"
          ]
        },
        "text": {
          "type": "string"
        },
        "boolean": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "puzzle_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "answer"
      ],
      "properties": {
        "prompt": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "puzzle_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "items"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "puzzle_solution": {

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';
---

<BaseLayout title="Page not found" noindex={true}>
  <h1>Page not found</h1>
  <p class="lede">That page doesn't exist, or the lesson isn't published yet.</p>
  <ul class="choice-list">
    <li>
      <a href={withBase('/teacher/')}><span class="choice-title">Teacher lessons</span></a>
    </li>
    <li>
      <a href={withBase('/family/')}><span class="choice-title">Parent devotionals</span></a>
    </li>
  </ul>
</BaseLayout>

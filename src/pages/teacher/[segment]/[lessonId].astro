---
// Teacher lesson page, kept deliberately simple for a busy volunteer:
// header, one in-class card, two collapsed sections, one print button.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ZeroPrepCard from '../../../components/teacher/ZeroPrepCard.astro';
import DeliveryProfiles from '../../../components/teacher/DeliveryProfiles.astro';
import { getPublicLessons, getResourceById } from '../../../lib/content/loader';
import { CONTENT_MODE } from '../../../lib/content/site';
import { slugFromSegment } from '../../../lib/content/segments';
import { toTeacherViewModel } from '../../../lib/view-models/teacher';
import type { LessonContent } from '../../../types';

export function getStaticPaths() {
  return getPublicLessons(CONTENT_MODE).map((lesson) => ({
    params: {
      segment: slugFromSegment(lesson.curriculum.segment),
      lessonId: lesson.lesson_id.toLowerCase(),
    },
    props: { lesson },
  }));
}

interface Props {
  lesson: LessonContent;
}

const { lesson } = Astro.props;
const vm = toTeacherViewModel(lesson);
const slug = slugFromSegment(vm.segment);
const isDraft = !['approved', 'scheduled', 'published'].includes(lesson.status);
const primaryPassages = vm.passages.map((passage) => passage.reference).join('; ');
---

<BaseLayout title={`${vm.title} · Teacher`} section="teacher" description={vm.bigIdea}>
  <nav aria-label="Breadcrumb" style="margin-bottom: var(--space-4);">
    <a class="back-link" href={`/teacher/${slug}/`}>&larr; Back to {vm.segment} lessons</a>
  </nav>

  <header style="margin-bottom: var(--space-5);">
    <p class="eyebrow">
      {vm.segment} · {vm.ageRange} · Lesson {vm.sequence}
      {isDraft && <span class="badge badge--draft">Draft: not yet approved</span>}
    </p>
    <h1>{vm.title}</h1>
    <p class="lede"><strong>{primaryPassages}</strong></p>
    <p>{vm.bigIdea}</p>
  </header>

  <DeliveryProfiles teacher={vm.teacher} lessonId={vm.lessonId} />

  <details class="section">
    <summary>More help: full script, questions, and printables</summary>
    <div class="section-body">
      <p class="choice-hint">
        A word-for-word way to run the lesson, plus every question, activity, and printable.
      </p>

      <ZeroPrepCard card={vm.teacher.zero_prep_card} />

      <h3>Discussion questions</h3>
      <ul>
        {
          vm.teacher.discussion_questions.map((question) => (
            <li>
              <strong>{question.question}</strong>
              {question.foundation_prompt && (
                <>
                  <br />
                  <span class="choice-hint">Simple answer: {question.foundation_prompt}</span>
                </>
              )}
              {question.extension_prompt && (
                <>
                  <br />
                  <span class="choice-hint">Going deeper: {question.extension_prompt}</span>
                </>
              )}
            </li>
          ))
        }
      </ul>

      <h3>Activities</h3>
      {
        vm.teacher.activities.map((activity) => (
          <div class="notice">
            <h4 style="margin-bottom: var(--space-1);">
              {activity.title} · {activity.duration_minutes} min
            </h4>
            {activity.materials.length > 0 && <p>Materials: {activity.materials.join('; ')}</p>}
            <ol>
              {activity.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>
            {activity.low_resource_alternative && (
              <p style="margin-bottom: 0;">
                <strong>Low-resource option:</strong> {activity.low_resource_alternative}
              </p>
            )}
          </div>
        ))
      }

      {
        vm.printables.length > 0 && (
          <>
            <h3>Printables</h3>
            <ul>
              {vm.printables.map((printable) => {
                const resource = getResourceById(printable.resourceId);
                return (
                  <li>
                    {resource ? (
                      <a href={`/print/resource/${printable.resourceId.toLowerCase()}/`}>
                        {printable.title}
                      </a>
                    ) : (
                      printable.title
                    )}{' '}
                    <span class="choice-hint">({printable.format})</span>
                  </li>
                );
              })}
            </ul>
          </>
        )
      }
    </div>
  </details>

  <details class="section">
    <summary>Prepare before class (optional, about {vm.teacher.preparation_minutes} minutes)</summary>
    <div class="section-body">
      <h3>Passage context</h3>
      <p>{vm.teacher.preparation.passage_context}</p>
      <ul>
        {vm.teacher.preparation.text_observations.map((observation) => <li>{observation}</li>)}
        {vm.teacher.preparation.interpretation_notes.map((note) => <li>{note}</li>)}
      </ul>

      <h3>Keep it faithful</h3>
      <ul>
        {vm.teacher.preparation.theological_guardrails.map((guardrail) => <li>{guardrail}</li>)}
        {
          vm.claims
            .filter((claim) => claim.prohibited_overstatement)
            .map((claim) => <li>Do not overstate: {claim.prohibited_overstatement}</li>)
        }
      </ul>

      {
        vm.teacher.preparation.likely_questions.length > 0 && (
          <>
            <h3>Questions children may ask</h3>
            <dl class="kv">
              {vm.teacher.preparation.likely_questions.map((question) => (
                <>
                  <dt>{question.question}</dt>
                  <dd>
                    {question.foundation_prompt && <p>Simple answer: {question.foundation_prompt}</p>}
                    {question.extension_prompt && (
                      <p>Going deeper: {question.extension_prompt}</p>
                    )}
                  </dd>
                </>
              ))}
            </dl>
          </>
        )
      }

      <h3>Every child can join in</h3>
      <ul>
        {vm.accessibility.neurodiversity_supports.map((support) => <li>{support}</li>)}
        {vm.accessibility.sensory_notes.map((note) => <li>{note}</li>)}
        {vm.accessibility.non_reader_support.map((support) => <li>{support}</li>)}
      </ul>
    </div>
  </details>

  <section class="actions" aria-label="Print">
    <a
      class="button"
      href={`/print/teacher/${vm.lessonId.toLowerCase()}/standard/`}
      data-print-link
      data-print-base={`/print/teacher/${vm.lessonId.toLowerCase()}`}
    >
      Print this lesson
    </a>
  </section>
</BaseLayout>

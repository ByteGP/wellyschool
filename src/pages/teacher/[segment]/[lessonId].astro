---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ZeroPrepCard from '../../../components/teacher/ZeroPrepCard.astro';
import DeliveryProfiles from '../../../components/teacher/DeliveryProfiles.astro';
import { getPublicLessons, getResourceById } from '../../../lib/content/loader';
import { CONTENT_MODE } from '../../../lib/content/site';
import { slugFromSegment } from '../../../lib/content/segments';
import { toTeacherViewModel } from '../../../lib/view-models/teacher';
import type { LessonContent } from '../../../types';

export function getStaticPaths() {
  return getPublicLessons(CONTENT_MODE).map((lesson) => ({
    params: {
      segment: slugFromSegment(lesson.curriculum.segment),
      lessonId: lesson.lesson_id.toLowerCase(),
    },
    props: { lesson },
  }));
}

interface Props {
  lesson: LessonContent;
}

const { lesson } = Astro.props;
const vm = toTeacherViewModel(lesson);
const slug = slugFromSegment(vm.segment);
const isDraft = !['approved', 'scheduled', 'published'].includes(lesson.status);
const primaryPassages = vm.passages.map((passage) => passage.reference).join('; ');
---

<BaseLayout title={`${vm.title} · Teacher`} section="teacher" description={vm.bigIdea}>
  <nav aria-label="Breadcrumb" style="margin-bottom: var(--space-4);">
    <a class="back-link" href={`/teacher/${slug}/`}>&larr; Back to {vm.segment} lessons</a>
  </nav>

  <header>
    <p class="eyebrow">
      {vm.segment} · {vm.ageRange} · {vm.cycleName} · Lesson {vm.sequence}
      {isDraft && <span class="badge badge--draft">Draft: not yet approved</span>}
    </p>
    <h1>{vm.title}</h1>
    <p class="lede"><strong>{primaryPassages}</strong></p>
    <p><strong>Objective:</strong> {vm.teacher.zero_prep_card.objective}</p>
    <p><strong>Big idea:</strong> {vm.bigIdea}</p>
  </header>

  <DeliveryProfiles teacher={vm.teacher} />

  <details class="section">
    <summary>Teaching suggestion: one way to run this lesson</summary>
    <div class="section-body">
      <p class="choice-hint">
        This is a suggested way you might teach the lesson, with no preparation needed. Open the
        outline above for the timed plan, and use this if you want ready-made wording.
      </p>
      <ZeroPrepCard card={vm.teacher.zero_prep_card} />
    </div>
  </details>

  <details class="section">
    <summary>Questions, activities, and printables</summary>
    <div class="section-body">
    <h3>Discussion questions</h3>
    <ul>
      {
        vm.teacher.discussion_questions.map((question) => (
          <li>
            <strong>{question.question}</strong>
            {question.foundation_prompt && (
              <>
                <br />
                <span class="choice-hint">Foundation: {question.foundation_prompt}</span>
              </>
            )}
            {question.extension_prompt && (
              <>
                <br />
                <span class="choice-hint">Extension: {question.extension_prompt}</span>
              </>
            )}
          </li>
        ))
      }
    </ul>

    <h3>Activities</h3>
    {
      vm.teacher.activities.map((activity) => (
        <div class="notice">
          <h4 style="margin-bottom: var(--space-1);">
            {activity.title} · {activity.duration_minutes} min
          </h4>
          {activity.materials.length > 0 && <p>Materials: {activity.materials.join('; ')}</p>}
          <ol>
            {activity.steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
          <p style="margin-bottom: 0;">
            <strong>Why:</strong> {activity.learning_link}
          </p>
          {activity.low_resource_alternative && (
            <p style="margin-bottom: 0;">
              <strong>Low-resource option:</strong> {activity.low_resource_alternative}
            </p>
          )}
        </div>
      ))
    }

    {
      vm.printables.length > 0 && (
        <>
          <h3>Printables</h3>
          <ul>
            {vm.printables.map((printable) => {
              const resource = getResourceById(printable.resourceId);
              return (
                <li>
                  {resource ? (
                    <a href={`/print/resource/${printable.resourceId.toLowerCase()}/`}>
                      {printable.title}
                    </a>
                  ) : (
                    printable.title
                  )}{' '}
                  <span class="choice-hint">
                    ({printable.format}) - {printable.purpose}
                  </span>
                </li>
              );
            })}
          </ul>
        </>
      )
    }
    </div>
  </details>

  <h2>Preparation and background</h2>
  <p class="choice-hint">
    If you would like to prepare ahead of the class, here is extra reading for you. It takes
    about {vm.teacher.preparation_minutes} minutes.
  </p>

  <details class="section">
    <summary>Passage context and observations</summary>
    <div class="section-body">
      <p>{vm.teacher.preparation.passage_context}</p>
      <h3>Text observations</h3>
      <ul>
        {vm.teacher.preparation.text_observations.map((observation) => <li>{observation}</li>)}
      </ul>
      <h3>Interpretation notes</h3>
      <ul>
        {vm.teacher.preparation.interpretation_notes.map((note) => <li>{note}</li>)}
      </ul>
      <p class="choice-hint">
        Genre: {vm.biblicalGenre} · Place in the story: {vm.metanarrativePosition}
      </p>
    </div>
  </details>

  <details class="section">
    <summary>What we can and cannot claim</summary>
    <div class="section-body">
      <ul>
        {
          vm.claims.map((claim) => (
            <li style="margin-bottom: var(--space-3);">
              <strong>{claim.statement}</strong>
              <br />
              <span class="badge">{claim.classification.replaceAll('_', ' ')}</span>{' '}
              <span class="choice-hint">
                {claim.evidence_refs.join('; ')} · confidence {claim.confidence}
              </span>
              {claim.interpretive_hinge && (
                <p style="margin: var(--space-1) 0 0;">Hinge: {claim.interpretive_hinge}</p>
              )}
              {claim.credible_alternative && (
                <p style="margin: var(--space-1) 0 0;">
                  Credible alternative: {claim.credible_alternative}
                </p>
              )}
              {claim.prohibited_overstatement && (
                <p style="margin: var(--space-1) 0 0;">
                  <strong>Do not overstate:</strong> {claim.prohibited_overstatement}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </details>

  <details class="section">
    <summary>Guardrails and likely questions</summary>
    <div class="section-body">
      <h3>Theological guardrails</h3>
      <ul>
        {vm.teacher.preparation.theological_guardrails.map((guardrail) => <li>{guardrail}</li>)}
      </ul>
      {
        vm.teacher.preparation.likely_questions.length > 0 && (
          <>
            <h3>Questions children may ask</h3>
            <dl class="kv">
              {vm.teacher.preparation.likely_questions.map((question) => (
                <>
                  <dt>{question.question}</dt>
                  <dd>
                    {question.foundation_prompt && <p>Simple answer: {question.foundation_prompt}</p>}
                    {question.extension_prompt && <p>Going deeper: {question.extension_prompt}</p>}
                    <p class="choice-hint">{question.purpose}</p>
                  </dd>
                </>
              ))}
            </dl>
          </>
        )
      }
    </div>
  </details>

  <details class="section">
    <summary>Accessibility and inclusion</summary>
    <div class="section-body">
      <p>{vm.accessibility.reading_level}</p>
      <p>{vm.accessibility.plain_language_rule}</p>
      <h3>Neurodiversity supports</h3>
      <ul>
        {vm.accessibility.neurodiversity_supports.map((support) => <li>{support}</li>)}
      </ul>
      {
        vm.accessibility.sensory_notes.length > 0 && (
          <>
            <h3>Sensory notes</h3>
            <ul>{vm.accessibility.sensory_notes.map((note) => <li>{note}</li>)}</ul>
          </>
        )
      }
      {
        vm.accessibility.non_reader_support.length > 0 && (
          <>
            <h3>Non-reader support</h3>
            <ul>{vm.accessibility.non_reader_support.map((support) => <li>{support}</li>)}</ul>
          </>
        )
      }
    </div>
  </details>

  <section class="card" aria-labelledby="closing-heading">
    <h2 id="closing-heading">Closing</h2>
    <p><strong>Memory verse:</strong> {vm.teacher.closing.memory_reference}</p>
    <p><strong>Prayer:</strong> {vm.teacher.closing.prayer_prompt}</p>
    <p><strong>Take-home line:</strong> {vm.teacher.closing.take_home_line}</p>
  </section>

  <section class="actions" aria-label="Print">
    <a class="button" href={`/print/teacher/${vm.lessonId.toLowerCase()}/standard/`}>
      Print lesson (Standard)
    </a>
    <a class="button button--secondary" href={`/print/teacher/${vm.lessonId.toLowerCase()}/essential/`}>
      Print Essential
    </a>
    <a class="button button--secondary" href={`/print/teacher/${vm.lessonId.toLowerCase()}/extended/`}>
      Print Extended
    </a>
  </section>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CurrentEntryCard from '../../../components/shared/CurrentEntryCard.astro';
import LessonBrowser from '../../../components/shared/LessonBrowser.astro';
import { getTermSettings } from '../../../lib/content/loader';
import { dateInTimeZone } from '../../../lib/schedule/date-selection';
import { SEGMENT_SLUGS, segmentFromSlug, type SegmentSlug } from '../../../lib/content/segments';

export function getStaticPaths() {
  return (Object.keys(SEGMENT_SLUGS) as SegmentSlug[]).map((segment) => ({
    params: { segment },
  }));
}

const { segment: slug } = Astro.params;
const segment = segmentFromSlug(slug)!;

// Link the planner to the current or nearest-upcoming term at build time.
const today = dateInTimeZone(new Date());
const terms = getTermSettings().terms.slice().sort((a, b) => a.start.localeCompare(b.start));
const currentTerm =
  terms.find((term) => today >= term.start && today <= term.end) ??
  terms.find((term) => term.start > today) ??
  terms[terms.length - 1];
---

<BaseLayout title={`Teachers · ${segment}`} section="teacher" description={`This Sunday's ${segment} lesson.`}>
  <nav aria-label="Breadcrumb" style="margin-bottom: var(--space-4);">
    <a class="back-link" href="/teacher/">&larr; Back to all groups</a>
  </nav>
  <h1>{segment} | Teachers</h1>
  <CurrentEntryCard role="teacher" segment={segment} />
  {
    currentTerm && (
      <p class="actions">
        <a class="button button--secondary" href={`/teacher/${slug}/planner/${currentTerm.term_id}/`}>
          Plan &amp; log this term
        </a>
      </p>
    )
  }
  <LessonBrowser role="teacher" segment={segment} />
</BaseLayout>

<script>
  // Remember the chosen segment locally (no accounts, no server state).
  try {
    const slug = window.location.pathname.split('/')[2];
    if (['kids', 'youths', 'teens'].includes(slug)) {
      window.localStorage.setItem('wellyschool.segment', slug);
    }
  } catch {
    // Storage unavailable; nothing to do.
  }
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SegmentChooser from '../../components/shared/SegmentChooser.astro';
---

<BaseLayout
  title="Parents"
  section="family"
  description="Choose your child's group for a guided 15-minute devotional that reinforces the Sunday lesson."
>
  <h1>Parents</h1>
  <p class="lede">
    Choose your child's group. Each devotional takes about 15 minutes and reinforces what was
    taught on Sunday.
  </p>
  <SegmentChooser role="family" />
</BaseLayout>
